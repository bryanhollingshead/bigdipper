---
// The dipper: seven stars, the same navy as Little Dipper's tab icon.
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="16" fill="var(--color-accent-700)" />
  <g fill="var(--color-bg)">
    <circle cx="7" cy="20" r="1.6" /><circle cx="11" cy="22.5" r="1.6" /><circle cx="15" cy="21" r="1.6" />
    <circle cx="15.5" cy="16.5" r="1.6" /><circle cx="19.5" cy="13" r="1.6" /><circle cx="23" cy="10.5" r="1.6" /><circle cx="26" cy="7.5" r="1.6" />
  </g>
</svg>
