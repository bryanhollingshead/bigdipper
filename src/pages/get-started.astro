---
import Base from '../layouts/Base.astro';
import HostingChoice from '../components/HostingChoice.astro';
import { RAILWAY_MONTHLY, RAILWAY_TEMPLATE_URL } from '../lib/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Get your Little Dipper" description="Set up your own Little Dipper on Railway in a few minutes, then make it yours with a passkey.">
  <div class="narrow hero" style="padding-bottom: 10px">
    <div class="kicker">Get your Little Dipper</div>
    <h1 style="font-size: clamp(36px, 5vw, 52px)">Your own Little Dipper in about ten minutes.</h1>
    <p class="lede">You’ll set up a small server with Railway, a hosting company, then claim it so it’s yours. This page walks you through it.</p>
  </div>

  <div class="narrow">
    <HostingChoice />

    <section>
      <h2>Before you start</h2>
      <ul class="prose">
        <li><strong>Cost:</strong> {RAILWAY_MONTHLY} a month, paid to Railway with your own card. Big Dipper doesn’t charge you anything.</li>
        <li><strong>You’ll need:</strong> an email address, a card for Railway, and a phone or computer that can use a passkey (your face, fingerprint, device PIN or a security key).</li>
        <li><strong>It’s yours:</strong> the server lives in your own Railway account. Big Dipper can’t see it or your data, and doesn’t need to.</li>
        <li><strong>If you stop paying Railway</strong>, they shut the server down. Save a backup to your computer first, and you can bring it back anywhere.</li>
      </ul>
    </section>

    <section style="padding-top: 8px">
      <h2>Three steps</h2>
      <ol class="steps" style="margin-top: 22px">
        <li>
          <div>
            <h3>Set it up on Railway</h3>
            <p>Railway asks you to sign up (or sign in). Then click <strong>Deploy</strong>: you don’t need to change anything. It takes about two minutes.</p>
            {RAILWAY_TEMPLATE_URL
              ? <p style="margin-top: 14px"><a id="deploy" class="btn btn-primary btn-lg" href={RAILWAY_TEMPLATE_URL} target="_blank" rel="noopener">Deploy on Railway</a></p>
              : <p class="note" style="margin-top: 10px"><span class="tag tag-accent">Almost ready</span> The Railway button arrives with the first release. Ask the person who invited you.</p>}
          </div>
        </li>
        <li>
          <div>
            <h3>Open your Little Dipper</h3>
            <p>When Railway shows your Little Dipper as active, click its link. It ends in <code>.up.railway.app</code>. Bookmark it: it’s where you’ll use your Little Dipper from now on.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Make it yours</h3>
            <p>Click <strong>Finish setting up</strong>. Your Little Dipper will already know it’s you. Add your name and a passkey (your face, fingerprint, device PIN or a security key), save your recovery codes, and you’re in.</p>
            <p class="note" style="margin-top: 8px">How does it know? This page made a private claim code in your browser and gave it to Railway with your setup. It goes only to Railway and to your Little Dipper. Set up from a different device? You’ll be asked for the code instead: in Railway, open your Little Dipper, then <strong>Variables → LD_CLAIM_TOKEN</strong>.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="band">
      <h3>Stuck?</h3>
      <p style="margin: 0">The <a href={`${base}/guide/railway`}>Railway guide</a> covers each step with more detail, and what to do when something doesn’t work.</p>
    </section>
  </div>
</Base>

<script>
  // The claim code: made here, handed to Railway in the Deploy link (it becomes LD_CLAIM_TOKEN). The new
  // Little Dipper's Finish setting up button comes back to /continue, which sends the owner in with it.
  // One per browser until the owner starts over. Big Dipper has no server and never sees it.
  const CODE = 'bigdipper.setup.code';
  const code = localStorage.getItem(CODE) || (() => {
    const bytes = crypto.getRandomValues(new Uint8Array(24));
    const c = 'bd' + Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    localStorage.setItem(CODE, c);
    return c;
  })();
  const deploy = document.getElementById('deploy') as HTMLAnchorElement | null;
  if (deploy) {
    const u = new URL(deploy.href);
    u.searchParams.set('LD_CLAIM_TOKEN', code);
    deploy.href = u.toString();
  }
</script>
