---
import Base from '../layouts/Base.astro';
import { RAILWAY_MONTHLY, RAILWAY_TEMPLATE_URL } from '../lib/config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Get your Little Dipper" description="Set up your own Little Dipper on Railway in a few minutes, then claim it with your passkey.">
  <div class="narrow hero" style="padding-bottom: 10px">
    <div class="kicker">Get your Little Dipper</div>
    <h1 style="font-size: clamp(36px, 5vw, 52px)">Your own Little Dipper in about ten minutes.</h1>
    <p class="lede">You’ll set up a small server with Railway, a hosting company, then claim it so it’s yours. This page walks you through it and remembers where you are if you leave.</p>
  </div>

  <div class="narrow">
    <section>
      <h2>Before you start</h2>
      <ul class="prose">
        <li><strong>Cost:</strong> {RAILWAY_MONTHLY} a month, paid to Railway with your own card. Big Dipper doesn’t charge you anything.</li>
        <li><strong>You’ll need:</strong> an email address, a card for Railway, and a phone or computer that can use a passkey (fingerprint, face or device PIN).</li>
        <li><strong>It’s yours:</strong> the server lives in your own Railway account. Big Dipper can’t see it or your data, and doesn’t need to.</li>
        <li><strong>If you stop paying Railway</strong>, they shut the server down. Save a backup to your computer first, and you can bring it back anywhere.</li>
      </ul>
    </section>

    <section style="padding-top: 8px">
      <h2>Four steps</h2>
      <ol class="steps" style="margin-top: 22px">
        <li>
          <div>
            <h3>Set it up on Railway</h3>
            <p>Railway asks you to sign up (or sign in), then builds your Little Dipper. It takes about two minutes.</p>
            {RAILWAY_TEMPLATE_URL
              ? <p style="margin-top: 14px"><a class="btn btn-primary btn-lg" href={RAILWAY_TEMPLATE_URL} target="_blank" rel="noopener">Deploy on Railway</a></p>
              : <p class="note" style="margin-top: 10px"><span class="tag tag-accent">Almost ready</span> The Railway button arrives with the first release. Ask the person who invited you.</p>}
          </div>
        </li>
        <li>
          <div>
            <h3>Find your new address</h3>
            <p>In Railway, open your Little Dipper, then <strong>Settings → Networking</strong>. Your address ends in <code>.up.railway.app</code>.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Check that it’s ready</h3>
            <form id="check" class="field" style="margin-top: 10px">
              <label for="addr">Your Little Dipper’s address</label>
              <div style="display: flex; gap: 8px; flex-wrap: wrap">
                <input id="addr" class="input" style="flex: 1; min-width: 240px; min-height: 44px" placeholder="something.up.railway.app" autocomplete="off" spellcheck="false" />
                <button class="btn btn-primary" type="submit">Check</button>
              </div>
            </form>
            <p id="result" class="note" role="status" style="margin-top: 10px"></p>
          </div>
        </li>
        <li>
          <div>
            <h3>Claim it</h3>
            <p>Your Little Dipper asks for its <strong>claim code</strong>. Only you can see it: in Railway, open your Little Dipper, then <strong>Variables → LD_CLAIM_TOKEN</strong>, and copy the value. Then add a passkey and save your recovery codes.</p>
            <p id="claim" style="margin-top: 12px" hidden><a id="claim-link" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Open my Little Dipper</a></p>
          </div>
        </li>
      </ol>
    </section>

    <section class="band">
      <h3>Stuck?</h3>
      <p style="margin: 0">The <a href={`${base}/guide/railway`}>Railway guide</a> covers each step with more detail, and what to do when something doesn’t work.</p>
    </section>
  </div>
</Base>

<script>
  // Everything here stays in this browser. Big Dipper has no server and never sees your address or code.
  const KEY = 'bigdipper.setup.address';
  const form = document.getElementById('check') as HTMLFormElement;
  const input = document.getElementById('addr') as HTMLInputElement;
  const result = document.getElementById('result')!;
  const claim = document.getElementById('claim')!;
  const link = document.getElementById('claim-link') as HTMLAnchorElement;

  const origin = (raw: string) => {
    const s = raw.trim().replace(/\/+$/, '');
    if (!s) return null;
    try { return new URL(/^https?:\/\//.test(s) ? s : `https://${s}`).origin; } catch { return null; }
  };

  const say = (text: string) => { result.textContent = text; };

  async function check(addr: string) {
    claim.hidden = true;
    say('Checking…');
    let d: { kind?: string; claimed?: boolean } | null = null;
    try {
      const r = await fetch(`${addr}/.well-known/little-dipper`, { cache: 'no-store' });
      d = r.ok ? await r.json() : null;
    } catch { d = null; }
    if (!d || d.kind !== 'node') return say('No Little Dipper answers there yet. If you just set it up, give it a minute and check again. Otherwise, check the address in Railway → Settings → Networking.');
    localStorage.setItem(KEY, addr);
    if (d.claimed) return say('This Little Dipper already has an owner. If it’s yours, sign in at its address.');
    say('It’s ready, and waiting for you to claim it.');
    link.href = `${addr}/claim`;
    claim.hidden = false;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const addr = origin(input.value);
    if (!addr) return say('That doesn’t look like a web address. It usually ends in .up.railway.app.');
    void check(addr);
  });

  const saved = localStorage.getItem(KEY);
  if (saved) { input.value = saved.replace(/^https:\/\//, ''); void check(saved); }
</script>
